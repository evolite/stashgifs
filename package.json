{
  "name": "stashgifs",
  "version": "6.0.0",
  "description": "StashGifs - TikTok-like vertical scroller interface for Stash.",
  "scripts": {
    "prebuild": "node scripts/generate-version.js",
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rm -rf app/assets/*.js app/assets/*.js.map",
    "codegen": "graphql-codegen --config codegen.yml",
    "codegen:watch": "graphql-codegen --config codegen.yml --watch",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@graphql-codegen/cli": "^7.0.0",
    "@graphql-codegen/typescript": "^6.0.1",
    "@graphql-codegen/typescript-operations": "^6.0.2",
    "@graphql-codegen/typescript-graphql-request": "^7.0.1"
  }
}
